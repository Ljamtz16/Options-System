[Unit]
Description=Options System signal episode TTT/hysteresis live shadow
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ljamtz/options-system
Environment=PYTHONPATH=/home/ljamtz/options-system:/home/ljamtz/options-system/src
ExecStart=/home/ljamtz/options-system/.venv/bin/python scripts/run_signal_episode_engine_live.py
Restart=always
RestartSec=5
Nice=8

[Install]
WantedBy=default.target
