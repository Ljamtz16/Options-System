[Unit]
Description=Options System intraday multi-asset collector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ljamtz
WorkingDirectory=/home/ljamtz/options-system
EnvironmentFile=/home/ljamtz/options-system/.env
Environment=PYTHONPATH=/home/ljamtz/options-system/src
ExecStart=/home/ljamtz/options-system/.venv/bin/python scripts/collect_intraday_options_universe.py
Nice=5
