[Unit]
Description=Options System frozen H01/H02/H03 live paper engine
After=network-online.target options-spy-collector.timer
Wants=network-online.target

[Service]
Type=simple
User=ljamtz
WorkingDirectory=/home/ljamtz/options-system
EnvironmentFile=/home/ljamtz/options-system/.env
Environment=PYTHONPATH=/home/ljamtz/options-system:/home/ljamtz/options-system/src
ExecStart=/home/ljamtz/options-system/.venv/bin/python scripts/run_frozen_hypotheses_live.py
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
