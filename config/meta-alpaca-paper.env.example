# Dedicated third Alpaca Paper account for Meta Portfolio.
# Keep the real file outside Git at ~/.config/options-system/meta-alpaca-paper.env
OPTIONS_ALPACA_PAPER_ENABLED=false
OPTIONS_ALPACA_SUBMIT_ORDERS=false
OPTIONS_ALPACA_API_KEY_ID=
OPTIONS_ALPACA_API_SECRET_KEY=
OPTIONS_ALPACA_MIRROR_START_UTC=2026-10-19T13:25:00+00:00
OPTIONS_ALPACA_SHADOW_CAPITAL=1000
